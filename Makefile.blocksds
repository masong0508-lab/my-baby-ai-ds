# Alternate Nintendo DS homebrew build using the BlocksDS runtime.
# Do NOT replace the already-working devkitPro Makefile.
# The key difference is an alternative ARM7 + ARM9 runtime, not a header patch.
# Reference: https://blocksds.skylyrac.net/docs/setup/docker/
export BLOCKSDS ?= /opt/blocksds/core
export WONDERFUL_TOOLCHAIN ?= /opt/wonderful
ARM_NONE_EABI_PATH ?= $(WONDERFUL_TOOLCHAIN)/toolchain/gcc-arm-none-eabi/bin/

NAME ?= my-baby-ai-blocksds
SOURCEDIRS ?= source
INCLUDEDIRS := include
ROM := $(NAME).nds
BUILDDIR := build/$(NAME)
ELF := $(BUILDDIR).elf
MAP := $(BUILDDIR).map
SPECS := $(BLOCKSDS)/sys/crts/ds_arm9.specs
ARM7ELF ?= $(BLOCKSDS)/sys/arm7/main_core/arm7_maxmod.elf

CC := $(ARM_NONE_EABI_PATH)arm-none-eabi-gcc
NDSTOOL := $(BLOCKSDS)/tools/ndstool/ndstool
ARCH := -mthumb -mcpu=arm946e-s+nofp
LIBDIRS := $(BLOCKSDS)/libs/libnds
LIBS := -lnds9 -lc
CPPFLAGS := -D__NDS__ -D__BLOCKSDS__ -DARM9 -Iinclude -I$(BLOCKSDS)/libs/libnds/include
CFLAGS := -O2 -Wall -Wextra -ffunction-sections -fdata-sections $(ARCH) -specs=$(SPECS)
LDFLAGS := $(ARCH) -Wl,--gc-sections -Wl,-Map,$(MAP) -L$(BLOCKSDS)/libs/libnds/lib -Wl,--start-group $(LIBS) -Wl,--end-group -specs=$(SPECS)

SOURCES := $(wildcard $(SOURCEDIRS)/*.c)
OBJECTS := $(patsubst %.c,$(BUILDDIR)/%.o,$(SOURCES))
DEPS := $(OBJECTS:.o=.d)

.PHONY: all clean
all: $(ROM)

$(ROM): $(ELF)
	$(NDSTOOL) -c $@ -7 $(ARM7ELF) -9 $<

$(ELF): $(OBJECTS)
	$(CC) -o $@ $^ $(LDFLAGS)

$(BUILDDIR)/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@

clean:
	rm -rf build/$(NAME) $(ELF) $(MAP) $(ROM)

-include $(DEPS)
